# Anthropic API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxxxx

# Model to use
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Database URL (SQLite for MVP)
DATABASE_URL=sqlite+aiosqlite:///./jee_coach.db

# Server settings
HOST=0.0.0.0
PORT=8001
DEBUG=true

# CORS: comma-separated origins ("*" for dev, "https://yourdomain.com" for prod)
CORS_ORIGINS=*

# Data paths
SYLLABUS_PATH=data/syllabus.json
NOTES_DIR=data/notes
